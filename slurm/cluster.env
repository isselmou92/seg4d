# ============================================================================
# cluster.env — shared cluster configuration
# Source this file in every job script:  source "$(dirname "$0")/cluster.env"
#
# Edit ALL paths below to match your cluster layout before submitting.
# ============================================================================

# ---- Singularity container ----
# Build once and copy to scratch:
#   singularity build seg4d.sif docker://youruser/seg4d:latest
export CONTAINER=/scratch/${USER}/containers/seg4d.sif

# ---- Patient data ----
# The directory passed to --data_dir; must contain a dicom/ sub-folder.
export DATA_DIR=/scratch/${USER}/4D_MR/PN001_MR1_MIT

# ---- Model checkpoints (bind-mounted into container at /checkpoints) ----
# Download once with:
#   huggingface-cli download wanglab/MedSAM2 MedSAM2_MRI_LiverLesion.pt \
#       --local-dir /scratch/${USER}/checkpoints
export CHECKPOINTS_DIR=/scratch/${USER}/checkpoints

# ---- MedSAM2 specific ----
export MEDSAM2_CKPT=/checkpoints/MedSAM2_MRI_LiverLesion.pt
export MEDSAM2_CFG=configs/sam2.1_hiera_t512.yaml

# ---- HuggingFace token (required for facebook/sam3 gated weights) ----
# Request access at https://huggingface.co/facebook/sam3
# Generate token at https://huggingface.co/settings/tokens
export HF_TOKEN=hf_YOUR_TOKEN_HERE

# ---- SLURM resource defaults (override per-job as needed) ----
export PARTITION=gpu
export ACCOUNT=your_project_account
export GPU_TYPE=a100          # e.g. a100, v100, rtx8000 — leave blank for any
export CPU_CORES=8
export MEM_GB=32
export TIME_CONVERT=01:00:00
export TIME_VOLUMETRIC=04:00:00
export TIME_DYNAMIC=06:00:00
export TIME_COMPARE=00:30:00
